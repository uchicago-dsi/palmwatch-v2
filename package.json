{
  "name": "palmwatch-site",
  "repository": "https://github.com/dsi-clinic/palmwatch-v2.git",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/gen-treeloss-rollups.mjs && pnpm exec tsx --tsconfig tsconfig.json scripts/precompute-worker-data.ts",
    "build": "next build",
    "dev": "next dev --turbopack",
    "start": "next start",
    "preview:next": "next build && next start",
    "lint": "eslint . --max-warnings 0",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "ultracite:fix:unsafe": "ultracite fix --unsafe",
    "format": "biome format --write .",
    "format:check": "biome format .",

    "precompute": "pnpm exec tsx --tsconfig tsconfig.json scripts/precompute-worker-data.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@deck.gl/core": "8.9.35",
    "@deck.gl/layers": "8.9.35",
    "@deck.gl/mapbox": "8.9.35",
    "@mapbox/mapbox-gl-geocoder": "5.0.1",
    "@math.gl/web-mercator": "3.6.3",
    "@portabletext/react": "3.0.11",
    "@sanity/image-url": "1.0.2",
    "@sanity/ui": "2.0.1",
    "@sanity/vision": "3.26.0",
    "@tailwindcss/typography": "0.5.10",
    "@tanstack/react-query": "4.35.3",
    "@turf/bbox": "6.5.0",
    "@types/node": "18.15.11",
    "@types/papaparse": "5.3.14",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "arquero": "5.2.0",
    "autoprefixer": "10.4.14",
    "daisyui": "3.7.7",
    "deck.gl": "8.9.35",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.4.1",
    "keyv": "4.5.4",
    "lodash": "4.17.21",
    "lodash.debounce": "4.0.8",
    "mapbox-gl": "2.15.0",
    "maplibre-gl": "3.3.1",
    "nanoid": "4.0.2",
    "next": "16.0.10",
    "next-sanity": "7.0.10",
    "papaparse": "5.4.1",
    "postcss": "8.4.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "2.4.0",
    "react-map-gl": "7.1.6",
    "react-papaparse": "4.2.2",
    "react-query": "3.39.3",
    "recharts": "3.1.0",
    "remove-accents": "^0.5.0",
    "sanity": "3.26.0",
    "styled-components": "~6.1.8",
    "tailwind-capitalize-first-letter": "1.0.4",
    "tailwindcss": "3.3.1",
    "typescript": "5.0.4",
    "zustand": "4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@opennextjs/cloudflare": "^1.19.9",
    "@types/ms": "0.7.31",
    "tsx": "^4.21.0",
    "turbo": "1.9.3",
    "ultracite": "^7.7.0",
    "wrangler": "^4.90.0"
  },
  "resolutions": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  }
}
