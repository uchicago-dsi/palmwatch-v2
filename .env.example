# Copy to `.env.local` for local development (see README).
# Values are not committed; fill in your own.

# --- Sanity (required for build / runtime; see sanity/env.ts) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# --- Map (required for map features) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional Mapbox style URL (app supplies a default if unset)
# NEXT_PUBLIC_MAPBOX_STYLE=

# --- Hosting / data URL resolution (optional) ---
# Canonical site origin, no trailing slash (recommended in production)
# NEXT_PUBLIC_SITE_URL=https://example.com
# On Cloudflare Pages, CF_PAGES_URL is set automatically for previews/production.

# --- Umami analytics (optional; both required or the script is not injected) ---
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami.example.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
